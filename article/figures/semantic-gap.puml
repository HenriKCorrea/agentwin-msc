        }
        .abstract {
            BackgroundColor #F5F5F5
            LineColor       #AAAAAA
            FontColor       #888888
        }
        .bridge {
            BackgroundColor #FDDDE6
            LineColor       #E91E63
            FontStyle       bold
        }
        .abstract {
            BackgroundColor #F5F5F5
            LineColor       #AAAAAA
