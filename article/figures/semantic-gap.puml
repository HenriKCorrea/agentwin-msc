        }
    }
    </style>

    package "Smart City Ontology" {

        note as SC_DT
          <b>DCAS Fleet Charging Network</b>
          Platform: KTWIN
          ─────────────────────────────────────
          Owns: station locations, plug counts,
                operational status, slot availability,
                allowed vehicle types
          No access to: ConEdison transformer loads
                        or grid capacity data
        end note


        enum GeoType {
            Point
            LineString
            Polygon
            MultiPoint
            MultiLineString
            MultiPolygon
        }

        ' <<bridge>> decision:
        ' - **`GeoLocation`** — the Smart City side of the GeoLocation ↔ Location semantic gap. Uses GeoJSON-typed geometry
        '   (type: GeoType, coordinates: string) as opposed to the Energy Grid CIM scalar Cartesian model
        '   (xPosition/yPosition). The agent must negotiate this coordinate system mismatch when correlating
        '   Smart City geographic entities with grid asset zones (e.g., SubGeographicalRegion → Substation).
        entity GeoLocation <<bridge>> {
            type: GeoType
            coordinates: string /' Depends on the type of the location. '/
        }

        ' Spatial-object represents everything that can have a spatial representation.
        ' It is superclass of feature and geometry.
        ' GeoSPARQL 1.0 is an OGC Standard.Copyright (c) 2012 Open Geospatial Consortium.
        entity SpatialObject <<abstract>> {
        }

        ' The class represents the top-level geometry type.
        ' This class is equivalent to the UML class GM_Object defined in ISO 19107, and it is superclass of all geometry types.
        ' GeoSPARQL 1.0 is an OGC Standard.Copyright (c) 2012 Open Geospatial Consortium.
        entity Geometry <<abstract>> extends SpatialObject {
        }

        ' This class represents the top-level feature type.
        ' This class is equivalent to GFI_Feature defined in ISO 19156:2011, and it is superclass of all feature types.
        ' GeoSPARQL 1.0 is an OGC Standard.Copyright (c) 2012 Open Geospatial Consortium.
        entity Feature <<abstract>> extends SpatialObject {
        }

        SpatialObject --> SpatialObject : Contains

        SpatialObject --> SpatialObject : Within

        Feature --> Geometry : hasGeometry



        ' entity Address <<context>> {
        '     ' addressCountry: string
        '     addressLocality: string
        '     addressRegion: string
        '     ' postOfficeBoxNumber: string
        '     ' postalCode: string
        '     ' streetAddress: string
        ' }

        entity NGSILDBaseModel <<abstract>> {
            ' dataProvider: string /' Specifies the URL to information about the provider of this information '/
            ' dateModified: dateTime
            ' dateCreated: dateTime
            ' source: string /' A sequence of characters giving the source of the entity data '/
            ' alternateName: string /' An alias for the entity. '/
            name: string /' The name of the entity. '/
            ' description: string /' A description of the entity. '/
            ' owner: string
            ' seeAlso: string /' List of comma separated URLs to one or more related entities. '/
        }

        NGSILDBaseModel *-- GeoLocation : location

        ' NGSILDBaseModel *-- Address : address


        enum VehicleType {
            bicycle
            bus
            car
            caravan
            motorcycle
            motorscooter
            truck
        }

        ' enum SocketType {
        '     Caravan_Mains_Socket
        '     CHAdeMO
        '     CCS_SAE
        '     Dual_CHAdeMO
        '     Dual_J_1772
        '     Dual_Mennekes
        '     J_1772
        '     Mennekes
        '     Other
        '     Tesla
        '     Type2
        '     Type3
        '     Wall_Euro
        ' }

        enum ChargingStationStatus {
            almostEmpty
            almostFull
            empty
            full
            outOfService
            withIncidence
            working
        }


        ' <<key>> decision:
        ' - **`EVChargingStation`** — the supply side from the Smart City perspective. `capacity` is the total number of vehicles
        '   that can charge simultaneously, `availableCapacity` is current availability, `status` maps to UsagePoint.connectionState,
        '   and `amperage` maps to UsagePoint.ratedCurrent. This is the entity the Smart City agent queries to answer
        '   "which stations are available and what power level do they offer?"
        '
        ' <<bridge>> decision:
        ' - **`EVChargingStation`** — the Smart City side of the EVChargingStation ↔ UsagePoint semantic gap. The Smart City models
        '   the charging station as physical infrastructure with availability counts and status enums, while the Energy Grid models
        '   the same socket as a logical UsagePoint with power metrics. Bridging this correspondence is the central semantic
        '   challenge the agent must solve.
        entity EVChargingStation <<key>> <<bridge>> extends NGSILDBaseModel {
            capacity: int /' The total number of vehicles which can be charged at the same time. The total number of sockets can be higher. '/
            ' socketNumber: int /' The total number of sockets offered by this charging station. '/ 
            availableCapacity: int /' The number of vehicles which currently can be charged. '/
            allowedVehicleType: VehicleType /' Vehicle type(s) which can be charged. '/
            ' socketType: SocketType /' The type of sockets offered by this station. '/
            ' openingHours: string /' The opening hours of the charging station. '/
            status: ChargingStationStatus /' Status of the charging station. '/
            ' network: string /' The name of the Network, with that the operator cooperates. '/
            ' operator: string /' Charging station's operator. '/
            ' contactPoint: ContactPoint /' Charging station contact point. '/
            ' amperage: double /' The total amperage offered by the charging station. Units:'Ampers (A) '/
            ' voltage: double /' The total voltage offered by the charging station. Units:'Volts (V)' '/
            ' chargeType: enum {annualPayment, flat, free, monthlyPayment, other} /'  '/
            ' acceptedPaymentMethod: enum {ByBankTransferInAdvance, ByInvoice, Cash, CheckInAdvance, COD, DirectDebit, GoogleCheckout, PayPal, PaySwarm} /' Type(s) of charge when using this station. Model:'https://schema.org/Text'. Enum:'ByBankTransferInAdvance, ByInvoice, Cash, CheckInAdvance, COD, DirectDebit, GoogleCheckout, PayPal, PaySwarm' '/
        }


        ' Generic class for describing city objects.
        entity CityObject <<abstract>> extends Feature {
        }

        entity CityFurniture <<abstract>> extends CityObject {
        }

        entity Pole <<context>> extends CityFurniture {
        }

        ' Pole --> Streetlight : refStreetlight

        ' Pole --> AirQualityObserved : refAirQualityObserved

        ' Pole --> NoiseLevelObserved : refNoiseLevel

        ' Pole --> WeatherObserved : refWeather

        ' Pole --> CrowdFlowObserved : refCrowdFlow

        Pole --> EVChargingStation : refEVChargingStation

    }

    package "Energy Grid Ontology" {

        note as EG_DT
          <b>ConEdison Distribution Grid</b>
          Platform: Eclipse Ditto
          ─────────────────────────────────────
          Owns: transformer loads, substation zones,
                headroom per zone, EV charge-rate specs
          No access to: DCAS charging station
                        infrastructure or fleet assignments
        end note

        ' This is a root class to provide common identification for all classes needing identification and naming attributes.
        entity IdentifiedObject <<abstract>> {
            ' description: string /' The description is a free human readable text describing or naming the object. It may be non unique and may not correlate to a naming hierarchy. '/
            mRID: string /' Master resource identifier issued by a model authority. The mRID is unique within an exchange context. Global uniqueness is easily achieved by using a UUID, as specified in RFC 4122, for the mRID. The use of UUID is strongly recommended. For CIMXML data files in RDF syntax conforming to IEC 61970-552, the mRID is mapped to rdf:ID or rdf:about attributes that identify CIM object elements. '/
            name: string /' The name is any free human readable and possibly non unique text naming the object. '/
            ' energyIdentCodeEic: string /' The attribute is used for an exchange of the EIC code (Energy identification Code). The length of the string is 16 characters as defined by the EIC code. For details on EIC scheme please refer to ENTSO-E web site. '/
            ' shortName: string /' The attribute is used for an exchange of a human readable short name with length of the string 12 characters maximum. '/
        }


        ' Coordinate reference system
        entity CoordinateSystem <<context>> {
            name: string /' Coordinate system. For example, WGS84, ETRS89, etc. '/
            crsUrn: string /' A Uniform Resource Name (URN) for the coordinate reference system (crs) used to define `Location.PositionPoints`. An example would be the European Petroleum Survey Group (EPSG) code for a coordinate reference system, defined in URN under the Open Geospatial Consortium (OGC) namespace as: urn:ogc:def:uom:EPSG::XXXX, where XXXX is an EPSG code (a full list of codes can be found at the EPSG Registry web site http://www.epsg-registry.org/). To define the coordinate system as being WGS84 (latitude, longitude) using an EPSG OGC, this attribute would be urn:ogc:def:uom:EPSG::4236. A profile should limit this code to a set of allowed URNs agreed to by all sending and receiving parties. '/
        }

        ' Set of spatial coordinates that determine a point, defined in the coordinate system specified in 'Location.CoordinateSystem'. Use a single position point instance to desribe a point-oriented location. Use a sequence of position points to describe a line-oriented object (physical location of non-point oriented objects like cables or lines), or area of an object (like a substation or a geographical zone - in this case, have first and last position point with the same values).
        entity PositionPoint <<context>> {
            xPosition: double /' X axis position. '/
            yPosition: double /' Y axis position. '/
            zPosition: double /' (if applicable) Z axis position. '/
            sequenceNumber: integer /' Zero-relative sequence number of this point within a series of points. Default: 0 '/
        }

        ' Location is used to define the absolute position of an assets
        ' The place, scene, or point of something where someone or something has been, is, and/or will be at a given moment in time.
        '
        ' <<bridge>> decision:
        ' - **`Location`** — the Energy Grid side of the Location ↔ GeoLocation semantic gap. CIM models position as scalar
        '   Cartesian coordinates (xPosition/yPosition), while the Smart City ontology uses GeoJSON-typed geometry
        '   (type: GeoType, coordinates: string). The agent must negotiate this coordinate system mismatch when
        '   correlating grid assets (e.g., Substation zones) with Smart City geographic entities.
        entity Location <<bridge>> <<context>> {
            locationName: string /' location Name '/
        }

        Location --> CoordinateSystem : CoordinateSystem /' Coordinate system used to describe position points of this location. '/
        Location --> PositionPoint : PositionPoints /' Sequence of position points describing this location. '/


        ' A power system resource (PSR) can be an item of equipment such as a switch, an equipment container containing many individual items of equipment such as a substation, or an organisational entity such as sub-control area. Power system resources can have measurements associated.
        entity PowerSystemResource <<abstract>> extends IdentifiedObject {
        }

        PowerSystemResource --> Location : Location /' Location of this power system resource. Default: None '/

        ' Connectivity nodes are points where terminals of AC conducting equipment are connected together with zero impedance.
        entity ConnectivityNode <<context>> extends IdentifiedObject {
            terminalCount: integer /' The connectivity node to which this terminal connects with zero impedance. This propoerty to defined total number of terminals connected to a node. '/
        }

        ' A base class for all objects that may contain connectivity nodes or topological nodes.
        entity ConnectivityNodeContainer <<abstract>> extends PowerSystemResource {
        }

        ' ConnectivityNode --> BoundaryPoint : BoundaryPoint /' The boundary point associated with the connectivity node. '/
        ConnectivityNode --> ConnectivityNodeContainer : ConnectivityNodeContainer /' Container of this connectivity node. '/
        ConnectivityNodeContainer --> ConnectivityNode : ConnectivityNodes /' Connectivity nodes which belong to this connectivity node container. '/


        ' A modelling construct to provide a root class for containing equipment.
        entity EquipmentContainer <<abstract>> extends ConnectivityNodeContainer {
            ' Equipments --> Equipment /' Contained equipment. '/
        }

        ' The parts of a power system that are physical devices, electronic or mechanical.
        entity Equipment <<abstract>> extends PowerSystemResource {
            ' aggregate: float /' The aggregate flag provides an alternative way of representing an aggregated (equivalent) element. It is applicable in cases when the dedicated classes for equivalent equipment do not have all of the attributes necessary to represent the required level of detail.  In case the flag is set to “true” the single instance of equipment represents multiple pieces of equipment that have been modelled together as an aggregate equivalent obtained by a network reduction procedure. Examples would be power transformers '/
            ' normallyInService: float /' Specifies the availability of the equipment under normal operating conditions. True means the equipment is available for topology processing, which determines if the equipment is energized or not. False means that the equipment is treated by network applications as if it is not in the model. '/
            ' EquipmentContainer --> EquipmentContainer /' Container of this equipment. '/
            ' -- OperationalLimitSet --> OperationalLimitSet /' The operational limit sets associated with this equipment. '/
        }

        ' Defines a system base voltage which is referenced.
        ' entity BaseVoltage extends IdentifiedObject {
        '     nominalVoltage: float /' The power system resource's base voltage. Shall be a positive value and not zero. '/
        ' }

        ' The parts of the AC power system that are designed to carry current or that are conductively connected through terminals.
        entity ConductingEquipment <<abstract>> extends Equipment {
        }

        ' EquipmentContainer "Equipments" <--> "EquipmentContainer" Equipment : contains /' Contained equipment. '/
        Equipment --> EquipmentContainer : EquipmentContainer /' Container of this equipment. '/

        EquipmentContainer --> Equipment : Equipments /' Contained equipment. '/

        ' ConductingEquipment --> BaseVoltage : BaseVoltage /' Base voltage of this conducting equipment. Use only when there is no voltage level container used and only one base voltage applies. For example, not used for transformers. '/


        ' A connection of energy generation or consumption on the power system model.
        entity EnergyConnection <<abstract>> extends ConductingEquipment {
        }

        ' According to IEC 61970-301, an EnergyConsumer is a generic user of energy - a  point of consumption on the power system model.
        ' EnergyConsumer.pfixed, .qfixed, .pfixedPct and .qfixedPct have meaning
        ' only if there is no LoadResponseCharacteristic associated with EnergyConsumer or
        ' if LoadResponseCharacteristic.exponentModel is set to False.
        entity EnergyConsumer <<context>> extends EnergyConnection {
            ' pfixed: float /' Active power of the load that is a fixed quantity and does not vary as load group value varies. Load sign convention is used, i.e. positive sign means flow out from a node.  '/
            ' pfixedPct: float /' Fixed active power as a percentage of load group fixed active power. Used to represent the time-varying components.  Load sign convention is used, i.e. positive sign means flow out from a node. '/
            ' qfixed: float /' Reactive power of the load that is a fixed quantity and does not vary as load group value varies. Load sign convention is used, i.e. positive sign means flow out from a node. '/
            ' qfixedPct: float /' Fixed reactive power as a percentage of load group fixed reactive power. Used to represent the time-varying components.  Load sign convention is used, i.e. positive sign means flow out from a node. '/
        }

        ' According to IEC 61968-13, a MV  customer is a CustomerLoad.
        '
        ' <<key>> decision:
        ' - **`CustomerLoad`** — MV background load contributing to transformer stress. Its `p` (active power) is part of the total load
        '   the transformer must carry before any EV charging is added. The agent must sum all CustomerLoad.p values under a
        '   transformer to correctly compute available headroom: headroom = ratedS − (ΣCustomerLoad.p + ΣEquivalentLoad.p + ΣUsagePoint.estimatedLoad).
        '   Without it, the agent risks overloading a transformer that is already near capacity from MV commercial/industrial customers.
        entity CustomerLoad <<key>> extends EnergyConsumer {
            p: float /' Active power of the load. Load sign convention is used, i.e. positive sign means flow out from a node. For voltage dependent loads the value is at rated voltage. Starting value for a steady state solution. Default: 0.0 '/
            ' q: float /' Reactive power of the load. Load sign convention is used, i.e. positive sign means flow out from a node. For voltage dependent loads the value is at rated voltage. Starting value for a steady state solution. Default: 0.0 '/
            ' powerFactor: float /' the power factor value '/
        }

        ' According to IEC 61968-13, a LV customer is an EquivalentLoad.
        ' An EquivalentLoad has the attribute customerCount having its value greater than one
        ' to indicate the number of customers attached.
        ' The voltage level is specified by a voltage level that contains this EquivalentLoad.
        entity EquivalentLoad <<key>> extends EnergyConsumer {
            p: float /' Active power of the load. Load sign convention is used, i.e. positive sign means flow out from a node. For voltage dependent loads the value is at rated voltage. Starting value for a steady state solution. Default: 0.0 '/
            ' q: float /' Reactive power of the load. Load sign convention is used, i.e. positive sign means flow out from a node. For voltage dependent loads the value is at rated voltage. Starting value for a steady state solution. Default: 0.0 '/
            ' powerFactor: float /' the power factor value '/
            customerCount: integer /' the attribute that indicate the number of customers attached '/    
        }

        ' CustomerLoad --> VoltageLevel : MemberOf_EquipmentContainerVL /' A CustomerLoad can be assciated to an equipment container via the same voltage level. '/




        ' The type of substations
        ' MV/LV type determines which distribution level serves the charging stations
        ' enum SubstationType {
        '     MV_MV_substation /' (Medium→Medium Voltage): upstream bulk grid, connects to MV/LV substations further down '/
        '     MV_LV_substation /' (Medium→Low Voltage, e.g., 11kV→400V): the "last mile" substation that directly serves neighborhoods, homes, and most charging stations '/
        '     LV_LV_substation /' (Low→Low Voltage): rare, special applications '/
        ' }

        ' An electrical device consisting of two or more coupled windings, with or without a magnetic core, for introducing mutual coupling between electric circuits.
        ' Transformers can be used to control voltage and phase shift (active power flow).
        ' A power transformer may be composed of separate transformer tanks that need not be identical.
        ' A power transformer can be modelled with or without tanks and is intended for use in both balanced and unbalanced representations.
        ' A power transformer typically has two terminals.
        '
        entity PowerTransformer <<context>> extends ConductingEquipment {
            ' Name: string /' Power transformer name. For example, SAMWA0001 '/
            ' PowerTransformerEnd: double /' The power transformer of this power transformer end. WARNING: This attribute is an inconsistency. Probably copy and paste error. '/
            ' beforeShCircuitHighestOperatingCurrent: double /' The highest operating current (Ib in the IEC 60909-0) before short circuit (depends on network configuration and relevant reliability philosophy). It is used for calculation of the impedance correction factor KT defined in IEC 60909-0. Default: 0.0 '/
            ' beforeShCircuitHighestOperatingVoltage: double /' The highest operating voltage (Ub in the IEC 60909-0) before short circuit. It is used for calculation of the impedance correction factor KT defined in IEC 60909-0. This is worst case voltage on the low side winding (Section 3.7.1 in the standard). Used to define operating conditions. Default: 0.0 '/
            ' beforeShortCircuitAnglePf: double /' The angle of power factor before short circuit (phib in the IEC 60909-0). It is used for calculation of the impedance correction factor KT defined in IEC 60909-0. This is the worst case power factor. Used to define operating conditions. Default: 0.0 '/
            ' highSideMinOperatingU: double /' The minimum operating voltage (uQmin in the IEC 60909-0) at the high voltage side (Q side) of the unit transformer of the power station unit. A value well established from long-term operating experience of the system. It is used for calculation of the impedance correction factor KG defined in IEC 60909-0 Default: 0.0 '/
            ' isPartOfGeneratorUnit: double /' Indicates whether the machine is part of a power station unit. Used for short circuit data exchange according to IEC 60909 Default: False '/
            ' operationalValuesConsidered: double /' It is used to define if the data (other attributes related to short circuit data exchange) defines long term operational conditions or not. Used for short circuit data exchange according to IEC 60909. Default: False '/
        }

        ' A PowerTransformerEnd is associated with each Terminal of a PowerTransformer.
        ' The impedance values r, r0, x, and x0 of a PowerTransformerEnd represents a star equivalent as follows.
        ' 1) for a two Terminal PowerTransformer the high voltage (TransformerEnd.endNumber=1)
        ' PowerTransformerEnd has non zero values on r, r0, x, and x0 while the low voltage (TransformerEnd.endNumber=2)
        ' PowerTransformerEnd has zero values for r, r0, x, and x0.
        ' Parameters are always provided, even if the PowerTransformerEnds have the same values.
        '
        ' <<key>> decision:
        ' - **`PowerTransformerEnd`** — holds `ratedS`, the actual numeric capacity of the transformer in MVA. Without it, `PowerTransformer` is just a name — `ratedS` is the hard constraint the agent enforces when checking whether adding a new EV charging session would push the transformer past 95%.
        entity PowerTransformerEnd <<key>> {
            ' b: float /' Magnetizing branch susceptance (B mag).  The value can be positive or negative. '/
            ' g: float /' Magnetizing branch conductance. '/
            ' r: float /' Resistance (star-model) of the transformer end. The attribute shall be equal to or greater than zero for non-equivalent transformers. '/
            ratedS: float /' Normal apparent power rating (maximum power capacity). The attribute shall be a positive value. For a two-winding transformer the values for the high and low voltage sides shall be identical. '/
            ' ratedU: float /' Rated voltage: phase-phase for three-phase windings, and either phase-phase or phase-neutral for single-phase windings. A high voltage side, as given by TransformerEnd.endNumber, shall have a ratedU that is greater than or equal to ratedU for the lower voltage sides. The attribute shall be a positive value. '/
            ' x: float /' Positive sequence series reactance (star-model) of the transformer end. '/
            ' PowerTransformer --> PowerTransformer /' The power transformer of this power transformer end. '/
            ' connectionKind --> WindingConnection /' Kind of connection. '/
        }

        ' A collection of equipment for purposes other than generation or utilization, through which electric energy in bulk is passed for the purposes of switching or modifying its characteristics.
        entity Substation <<context>> extends EquipmentContainer {
            substationName: string /' The name of the substation. '/
            ' substationType: SubstationType /' The type of substations. '/
            ' dcConverterUnit --> DCConverterUnit /' The DC converter unit belonging of the substation. '/
            ' locatedAt --> SubGeographicalRegion /' The SubGeographicalRegion containing the substation. '/
        }

        PowerTransformerEnd --> PowerTransformer : PowerTransformer /' The power transformer of this power transformer end. '/

        PowerTransformer --> PowerTransformerEnd : PowerTransformerEnds /' The ends of this power transformer. '/

        PowerTransformer --> Substation : MemberOf_Substation /' The associations for PowerTransformer containment are: Substation -> PowerTransformer -> TransformerWinding '/

        ' Substation --> SubGeographicalRegion : locatedAt /' The SubGeographicalRegion containing the substation. '/


        ' Terminal topology
        ' The smartgrid ontology has `Terminal` with `conductingEquipment → ConductingEquipment` and `connectivityNode → ConnectivityNode`.
        ' The full CIM-correct path would be:
        '
        ' EnergyConsumer → Terminal → ConnectivityNode ← Terminal ← PowerTransformerEnd ← PowerTransformer
        '
        ' This is how a load flow solver would trace *which specific transformer winding* feeds which load electrically.
        ' It is much richer but requires instantiating `Terminal` and `ConnectivityNode` for every connection in your scenario graph.


        ' An electrical connection point (AC or DC) to a piece of conducting equipment.
        ' Terminals are connected at physical connection points called connectivity nodes.
        entity ACDCTerminal <<abstract>> extends IdentifiedObject {
            ' sequenceNumber: float /' The orientation of the terminal connections for a multiple terminal conducting equipment.  The sequence numbering starts with 1 and additional terminals should follow in increasing order.   The first terminal is the "starting point" for a two terminal branch. '/
            ' connected: boolean /' The connected status is related to a bus-branch model and the topological node to terminal relation.  True implies the terminal is connected to the related topological node and false implies it is not. '/
        }

        ' An AC electrical connection point to a piece of conducting equipment. Terminals are connected at physical connection points called connectivity nodes.
        entity Terminal <<context>> extends ACDCTerminal {
            ' phases: string /' Represents the normal network phasing condition. If the attribute is missing, three phases (ABC) shall be assumed, except for terminals of grounding classes (specializations of EarthFaultCompensator, GroundDisconnector, GroundSwitch, and Ground) which will be assumed to be N. '/
        }

        ' ACDCTerminal --> OperationalLimitSet : OperationalLimitSet /' The operational limit sets at the terminal. '/

        ' Terminal --> AuxiliaryEquipment : auxiliaryEquipment /' The auxiliary equipment connected to the terminal. '/
        Terminal --> ConductingEquipment : conductingEquipment /' The conducting equipment of the terminal.  Conducting equipment have  terminals that may be connected to other conducting equipment terminals via connectivity nodes or topological nodes. '/
        Terminal --> ConnectivityNode : connectivityNode /' The connectivity node to which this terminal connects with zero impedance. '/
        ' Terminal --> ACDCConverter : converterDCSides /' All converters' DC sides linked to this point of common coupling terminal. '/
        ' Terminal --> RegulatingControl : regulatingControl /' The controls regulating this terminal. '/
        ' Terminal --> TieFlow : tieFlow /' The control area tie flows to which this terminal associates. '/
        ' Terminal --> TransformerEnd : transformerEnd /' All transformer ends connected at this terminal. '/
        ' Terminal --> PhaseCode : phaseCodes /' Represents the normal network phasing condition. If the attribute is missing, three phases (ABC) shall be assumed, except for terminals of grounding classes (specializations of EarthFaultCompensator, GroundDisconnector, and Ground) which will be assumed to be N. Therefore, phase code ABCN is explicitly declared when needed, e.g. for star point grounding equipment. The phase code on terminals connecting same ConnectivityNode or same TopologicalNode as well as for equipment between two terminals shall be consistent. '/


        ' NOTE: EVChargingStation is referenced here for cross-domain linkage,
        ' but it is not defined in the Energy Grid ontology. It belongs to the Smart City ontology.
        entity EVChargingStation <<open-reference>> {
        }

        ' Adapted from CIM and https://github.com/smart-data-models/dataModel.EnergyCIM/ data models: an electric vehicle model
        ' An electric vehicle (EV) is a vehicle that uses one or more electric motors or traction motors for propulsion.
        ' An electric vehicle may be powered through a collector system by electricity from off-vehicle sources,
        ' or may be self-contained with a battery, solar panels, fuel cells or an electric generator to convert fuel to electricity.
        '
        ' <<key>> decision:
        ' - **`ElectricVehicle`** — the demand side of the problem. Its `chargeRateMax` sets the upper bound on which station power levels are compatible, `chargeTarget` quantifies how much energy is needed, and `chargeTargetTimestamp` establishes urgency. Without these, no assignment decision can be made.
        entity ElectricVehicle <<key>> {
            evName: string /' The name of the electric vehicle. '/
            ' capacity: double /' Total EV battery capacity. '/
            ' chargeMin: double /' Minimum charge limit. '/
            ' chargeRateMin: double /' Minimum charging rate. '/
            chargeRateMax: double /' Maximum charging rate. '/
            ' dischargeRateMin: double /' Minimum discharge rate. '/
            ' dischargeRateMax: double /' Maximum discharge rate. '/
            ' chargeTarget: double /' Target capacity to be charged '/
            ' chargeTargetTimestamp: dateTime /' Target end datetime to be charged '/
            ' -- connectedTo_ChargingStation --> EVChargingStation /' EV --> ChargingStation '/
        }

        ElectricVehicle --> EVChargingStation : connectedTo_ChargingStation /' EV --> ChargingStation '/

        note right of EVChargingStation
        Not defined in Energy Grid;
        belongs to Smart City ontology.
        end note

    }

"Energy Grid Ontology.EVChargingStation" ..> "Smart City Ontology.EVChargingStation" : resolves_to\n(defined in SC, not EG)
"Smart City Ontology.EVChargingStation" .. "Energy Grid Ontology.CustomerLoad" : same physical location\n(SC asset <-> EG load entity)
"Smart City Ontology.GeoLocation" .. "Energy Grid Ontology.Location" : GeoJSON (WGS84, RFC 7946)\nvs.\nCIM PositionPoints (OGC URN CRS)

' =====================================================
' Assignment Decision Formula
' =====================================================
note as Formula
  <b>EV Assignment Decision</b>
  ────────────────
  headroom = ratedS - Σ(CustomerLoad.p + EquivalentLoad.p)
  (per ConEdison transformer zone)

  Assign EV to station if:
    1. headroom - chargeRateMax ≥ 5% of ratedS
    2. station.status = working
    3. station.availableCapacity > 0
    4. station.allowedVehicleType ∋ vehicle.type
  ────────────────
end note

@enduml
