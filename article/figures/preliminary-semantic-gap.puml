@startuml Energy Grid Ontology (Pre-Patch)

' Purpose: show that Location exists in the published ontology but is only reachable
' from SubGeographicalRegion — not from the equipment hierarchy (CustomerLoad, EquivalentLoad).
' This is the structural gap that required the PowerSystemResource.Location patch.

<style>
ClassDiagram {
    .key {
        BackgroundColor #FFF3CD
        LineColor       #FFC107
        FontStyle       bold
    }
    .context {
        BackgroundColor #D6EAF8
        LineColor       #2E86C1
    }
    .abstract {
        BackgroundColor #F5F5F5
        LineColor       #AAAAAA
        FontColor       #888888
    }
    .bridge {
        BackgroundColor #FDDDE6
        LineColor       #E91E63
        FontStyle       bold
    }
}
</style>

package "Smart City Ontology" {
    entity GeoLocation <<bridge>> {
        type: string
        coordinates: string
    }

    entity NGSILDBaseModel <<abstract>> {
        name: string
    }

    NGSILDBaseModel *-- GeoLocation : location

    entity EVChargingStation <<key>> <<bridge>> extends NGSILDBaseModel {
        capacity: int
        availableCapacity: int
        amperage: double
        voltage: double
    }

    entity SpatialObject <<abstract>> {
    }

    SpatialObject --> SpatialObject : Contains
    SpatialObject --> SpatialObject : Within

    entity Feature <<abstract>> extends SpatialObject {
    }

    entity CityObject <<abstract>> extends Feature {
    }

    entity CityFurniture <<abstract>> extends CityObject {
    }

    entity Pole <<context>> extends CityFurniture {
    }

    entity AdministrativeArea <<abstract>> extends Feature {
    }

    entity District <<bridge>> extends AdministrativeArea {
    }

    entity Neighbourhood <<bridge>> extends AdministrativeArea {
    }

    Pole --> EVChargingStation : refEVChargingStation
}

package "Energy Grid Ontology (published)" {

    ' ── Geographic entities ─────────────────────────────────────────
    entity Location <<bridge>> <<context>> {
        locationName: string
        xPosition: double
        yPosition: double
    }

    entity SubGeographicalRegion <<context>> extends Location {
        name: string
        mRID: string
    }

    entity Substation <<context>> {
        substationName: string
    }

    Substation --> SubGeographicalRegion : locatedAt

    ' ── Equipment hierarchy ─────────────────────────────────────────
    entity PowerSystemResource <<abstract>> {
        name: string
        mRID: string
    }

    note bottom of PowerSystemResource
    <b>No Location relationship</b>
    in published ontology
    end note

    entity Equipment <<abstract>> extends PowerSystemResource {
    }

    Substation --> Equipment : Equipments

    entity ConductingEquipment <<abstract>> extends Equipment {
    }

    entity EnergyConnection <<abstract>> extends ConductingEquipment {
    }

    entity EnergyConsumer <<context>> extends EnergyConnection {
    }

    entity CustomerLoad <<key>> extends EnergyConsumer {
        p: float
    }

    entity EquivalentLoad <<key>> extends EnergyConsumer {
        p: float
        customerCount: integer
    }
}

' ===== Cross-Domain Semantic Bridges =====

"Smart City Ontology.EVChargingStation" .. "Energy Grid Ontology (published).CustomerLoad" : same physical location\n<<no geographic path in EG>>
"Smart City Ontology.GeoLocation" ..> "Energy Grid Ontology (published).Location" : GeoJSON\nvs.\nCIM (x, y)
"Smart City Ontology.Neighbourhood" ..> "Energy Grid Ontology (published).SubGeographicalRegion" : civic zone\nvs.\nelectrical topology zone\n<<coarse correlation only>>
"Smart City Ontology.District" ..> "Energy Grid Ontology (published).Substation" : administrative boundary\nvs.\nsubstation service area

@enduml
